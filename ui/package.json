{
  "name": "tether-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && touch ../cmd/tether-web/dist/.gitkeep",
    "dev": "vite",
    "lint": "oxlint . --react-plugin --jsx-a11y-plugin --vitest-plugin",
    "lint:fix": "oxlint . --fix --react-plugin --jsx-a11y-plugin --vitest-plugin",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.4.0",
    "oxlint": "1.85.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
