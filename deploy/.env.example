# Copy to deploy/.env and replace ALL host-specific example paths and IDs.
# Configuration only: never place the Basic Auth password itself here.
TETHER_CORE_DIR=/home/your-user/src/tether-core
TETHER_UID=1000
TETHER_GID=1000
TETHER_DATA_DIR=/home/your-user/.local/share/tether-container
TETHER_DOWNLOADS_DIR=/home/your-user/tether-inbox
TETHER_RUNTIME_DIR=/run/tether-compose-1000
TETHER_WEB_PASSWORD_FILE=/home/your-user/.config/tether-web/password
TETHER_HOSTNAME=tether
# Conservative default; set to 1 only after verifying the host controller.
TETHER_BLUEZ_SECURE_CONNECTIONS=0
TETHER_VERSION=0.2.32-container-dev
TETHER_WEB_AUTH_USER=owner
# Include your HTTPS reverse proxy's exact Host name if using one.
TETHER_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
